{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "RateLimiting": {
    "Registro": {
      "PermitLimit": 5,
      "WindowMinutes": 10
    },
    "Login": {
      "PermitLimit": 10,
      "WindowMinutes": 10
    },
    "Solicitudes": {
      "PermitLimit": 120,
      "WindowMinutes": 60
    },
    "Global": {
      "PermitLimit": 600,
      "WindowMinutes": 60
    }
  },
  "Sesion": {
    "DuracionMinutos": 30,
    "CrossSite": false
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": []
  }
}
