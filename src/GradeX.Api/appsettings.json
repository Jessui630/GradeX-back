{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "RateLimiting": {
    "Registro": {
      "PermitLimit": 5,
      "WindowMinutes": 10
    },
    "Login": {
      "PermitLimit": 10,
      "WindowMinutes": 10
    },
    "Solicitudes": {
      "PermitLimit": 60,
      "WindowMinutes": 60
    },
    "Asignaciones": {
      "PermitLimit": 30,
      "WindowMinutes": 60
    },
    "Global": {
      "PermitLimit": 100,
      "WindowMinutes": 60
    }
  },
  "Sesion": {
    "DuracionMinutos": 30,
    "CrossSite": false
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": []
  },
  "Almacenamiento": {
    "Evidencias": {
      "Ruta": "App_Data/evidencias"
    }
  }
}
